{
  "listen": ":8080",
  "admin_listen": ":9090",
  "strategy": "round_robin",
  "hash_key": "header:X-User-ID",
  "max_retries": 2,
  "backends": [
    "http://127.0.0.1:9001",
    "http://127.0.0.1:9002",
    { "url": "http://127.0.0.1:9003", "weight": 2 }
  ],
  "health_check": {
    "path": "/healthz",
    "interval": "2s",
    "timeout": "500ms",
    "healthy_threshold": 2,
    "unhealthy_threshold": 2
  },
  "outlier_detection": {
    "consecutive_failures": 5,
    "base_ejection_time": "10s",
    "max_ejection_time": "5m",
    "max_ejection_percent": 50
  },
  "retry_budget": {
    "ratio": 0.2,
    "min_retries_per_second": 10
  },
  "max_inflight_per_backend": 0,
  "reload_interval": "2s",
  "rate_limit": {
    "redis": { "addr": "", "password_env": "REDIS_PASSWORD", "timeout": "50ms" },
    "on_redis_error": "local",
    "rules": [
      { "name": "login", "path_prefix": "/login", "methods": ["POST"], "limit": 5, "window": "1m" },
      { "name": "api", "path_prefix": "/", "limit": 100, "window": "1s", "key": "header:X-API-Key" }
    ]
  },
  "timeouts": {
    "dial": "1s",
    "read_header": "5s",
    "response_header": "10s",
    "idle_conn": "90s",
    "drain_delay": "0s",
    "shutdown_grace": "15s"
  }
}
